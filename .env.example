# Massive market data (https://api.massive.com)
# GET /options/chain/:symbol additionally requires a plan that includes the
# options chain snapshot endpoint (Options Starter or higher).
MASSIVE_API_KEY=your_api_key_here

# Optional overrides
# MASSIVE_REST_BASE_URL=https://api.massive.com
# MASSIVE_TIMEOUT_MS=15000
# MASSIVE_MAX_PAGES=5
# Keep only 09:30-16:00 ET bars (Massive aggregates include extended hours)
# MASSIVE_REGULAR_HOURS_ONLY=true

# Session-aware regime/signal timeframe
# Primary candle size used by regime and signal analysis
# MARKET_PRIMARY_TIMEFRAME_MINUTES=3
# Maximum indicator history (warm-up + current session), not a minimum
# MARKET_MAX_INDICATOR_CANDLES=80
# Minutes after 09:30 ET during which trade evaluation stays blocked
# OPENING_SETTLEMENT_MINUTES=15

# News intelligence (GET /news-intelligence/:symbol)
# Seeking Alpha's public RSS feeds need no credentials; set to false to run
# news intelligence on Massive news alone.
# SEEKING_ALPHA_RSS_ENABLED=true
# SEEKING_ALPHA_BASE_URL=https://seekingalpha.com
# NEWS_TIMEOUT_MS=8000

# Volatility intelligence (GET /volatility-intelligence/:symbol)
# Massive ticker for the volatility reference; Cboe indices use the I: prefix
# and need an indices entitlement on the Massive plan.
# VIX_SYMBOL=I:VIX
# Completed candles compared for short-term VIX momentum
# VIX_MOMENTUM_LOOKBACK_CANDLES=3
# Largest acceptable VIX/underlying timestamp drift before a staleness flag
# VIX_MAX_STALENESS_MINUTES=6

# PORT=3000
