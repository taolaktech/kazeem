# Massive market data (https://api.massive.com)
# GET /options/chain/:symbol additionally requires a plan that includes the
# options chain snapshot endpoint (Options Starter or higher).
MASSIVE_API_KEY=your_api_key_here

# Optional overrides
# MASSIVE_REST_BASE_URL=https://api.massive.com
# MASSIVE_TIMEOUT_MS=15000
# MASSIVE_MAX_PAGES=5
# Keep only 09:30-16:00 ET bars (Massive aggregates include extended hours)
# MASSIVE_REGULAR_HOURS_ONLY=true

# News intelligence (GET /news-intelligence/:symbol)
# Seeking Alpha's public RSS feeds need no credentials; set to false to run
# news intelligence on Massive news alone.
# SEEKING_ALPHA_RSS_ENABLED=true
# SEEKING_ALPHA_BASE_URL=https://seekingalpha.com
# NEWS_TIMEOUT_MS=8000

# PORT=3000
